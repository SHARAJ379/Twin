{
  "name": "twin",
  "version": "0.1.0",
  "private": true,
  "description": "Runs two copies of your app and shows you where they disagree.",
  "keywords": ["testing", "multi-instance", "differential-testing", "cli", "regression-testing"],
  "license": "MIT",
  "author": "Sharaj R Shetty",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SHARAJ379/twin.git"
  },
  "homepage": "https://github.com/SHARAJ379/twin#readme",
  "bugs": {
    "url": "https://github.com/SHARAJ379/twin/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "twin": "./dist/cli/index.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "depcheck": "depcruise src --config .dependency-cruiser.cjs",
    "verify": "npm run lint && npm run depcheck && npm run typecheck && npm run build && npm run test",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^12.1.0",
    "dotenv": "^18.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.0.0",
    "dependency-cruiser": "^16.4.0",
    "eslint": "^9.9.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
